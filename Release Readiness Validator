import java.time.Instant
import java.time.LocalDate
import java.time.ZoneId

if (issue == null) {
    return false
}

def fixVersions = issue.fixVersions

if (fixVersions == null || fixVersions.size() != 1) {
    return false
}

def version = fixVersions.iterator().next()

if (version.released) {
    return false
}

def releaseDate = version.releaseDate

if (releaseDate != null) {
    def zone = ZoneId.systemDefault()
    def today = LocalDate.now(zone)
    def scheduledDate = Instant.ofEpochMilli(releaseDate.time)
            .atZone(zone)
            .toLocalDate()

    if (scheduledDate.isBefore(today)) {
        return false
    }
}

return true
