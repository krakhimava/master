import com.atlassian.jira.component.ComponentAccessor
import com.atlassian.jira.permission.ProjectPermissions
import org.apache.log4j.Logger

def log = Logger.getLogger("com.acme.permission.audit")

def projectManager = ComponentAccessor.projectManager
def permissionSchemeManager = ComponentAccessor.permissionSchemeManager

def expectedGroup = "jira-users"

projectManager.projectObjects.each { project ->

    def scheme = permissionSchemeManager.getSchemeFor(project)

    if (!scheme) {
        log.warn("Project ${project.key} has no permission scheme")
        return
    }

    def browsePermissions = scheme.getEntitiesByType("group").findAll { entity ->
        def typeId = entity.entityTypeId?.toString()
        typeId == ProjectPermissions.BROWSE_PROJECTS.permissionKey || typeId == "1"
    }

    browsePermissions.each { permission ->
        if (permission.parameter != expectedGroup) {
            log.warn(
                "Permission audit: Project ${project.key} grants Browse Projects " +
                "to unexpected group '${permission.parameter}'"
            )
        }
    }
}
